# =============================================
# PRODUCTION ENV — dùng khi deploy lên Vercel
# Copy nội dung này vào Vercel > Settings > Environment Variables
# =============================================

# Backend API (Render)
VITE_API_URL=https://realtime-chat-application-backend-s916.onrender.com/api
VITE_SOCKET_URL=https://realtime-chat-application-backend-s916.onrender.com/api

# Firebase Configuration (điền từ Firebase Console)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# OAuth Feature Flags
VITE_GOOGLE_OAUTH_ENABLED=true
VITE_GITHUB_OAUTH_ENABLED=true
