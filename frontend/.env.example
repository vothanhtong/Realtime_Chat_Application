# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment (Vite) — copy to `.env` and fill in.
# Every VITE_* value is embedded in the public JS bundle: put NO secrets here.
# (Firebase web config is public by design; protect it with Firebase rules and
#  authorized domains, not by hiding it.)
# ─────────────────────────────────────────────────────────────────────────────

# Backend REST base URL — must end with /api
VITE_API_URL=http://localhost:5001/api

# Backend origin for Socket.IO (no /api)
VITE_SOCKET_URL=http://localhost:5001

# Show "Sign in with Google / GitHub" buttons ("true" / "false").
# Also requires the Firebase config below and Firebase Admin on the backend.
VITE_GOOGLE_OAUTH_ENABLED=false
VITE_GITHUB_OAUTH_ENABLED=false

# Firebase web app config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
