# ─────────────────────────────────────────────────────────────────────────────
# Backend environment — copy to `.env` and fill in real values.
# NEVER commit `.env` (it is git-ignored). Required vars are marked [REQUIRED];
# the server refuses to start without them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# "production" enables secure cookies (SameSite=None; Secure), disables
# /api-docs and the dev-only port auto-increment.
NODE_ENV=development
PORT=5001

# Public URL of THIS backend (no trailing slash). Used to whitelist
# locally-stored chat images (http(s)://<SERVER_URL>/uploads/...).
SERVER_URL=http://localhost:5001

# [REQUIRED] Frontend origin(s) allowed by CORS + Socket.IO, comma-separated.
# The FIRST one is used to build password-reset links.
CLIENT_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
# [REQUIRED]
MONGODB_CONNECTIONSTRING=mongodb://127.0.0.1:27017/chat_app

# ── Auth ─────────────────────────────────────────────────────────────────────
# [REQUIRED] Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
ACCESS_TOKEN_SECRET=change_me_to_a_long_random_secret

# ── Email (forgot-password) — SMTP ───────────────────────────────────────────
# Gmail: use an App Password (Google account → Security → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_app_password

# ── Image storage ────────────────────────────────────────────────────────────
# Cloudinary (recommended in production — Render's disk is wiped on redeploy).
# Leave empty to store images on local disk instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Local-disk storage root (only used when Cloudinary is not configured).
# Default: Backend/uploads
UPLOADS_DIR=

# ── Firebase Admin (Google / GitHub login) — pick ONE method ─────────────────
# 1) Put the service-account JSON at Backend/config/firebase-service-account.json
#    (git-ignored; see firebase-service-account.example.json), or
# 2) base64 of that JSON (for hosts without a file system, e.g. Render):
#    base64 -i firebase-service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=
# 3) or Google Cloud application-default credentials + project id:
FIREBASE_PROJECT_ID=

# ── Optional ─────────────────────────────────────────────────────────────────
# Force-enable/disable Swagger UI at /api-docs (default: on in dev, off in production)
API_DOCS_ENABLED=
